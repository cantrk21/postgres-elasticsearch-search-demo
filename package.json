{
  "name": "es-test",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "data:download": "node scripts/download-data.js",
    "populate": "node --env-file=.env.local scripts/populate.js",
    "verify": "node --env-file=.env.local scripts/verify.js",
    "setup": "npm run db:up && npm run data:download && npm run populate",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.19.2",
    "@neondatabase/serverless": "^1.0.2",
    "csv-parse": "^6.1.0",
    "fflate": "^0.8.3",
    "next": "16.3.8",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
